{
  "entities": {
    "ZetaTradeUser": {
      "title": "ZetaTradeUser",
      "description": "Registered trader account in ZetaTrade broker.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "realBalance": { "type": "number" },
        "demoBalance": { "type": "number" },
        "totalProfit": { "type": "number" },
        "totalLoss": { "type": "number" },
        "role": { "type": "string", "enum": ["user", "vip", "admin"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "tradesCount": { "type": "number" },
        "wonTradesCount": { "type": "number" }
      },
      "required": ["id", "name", "email", "realBalance", "demoBalance", "role", "status", "createdAt"]
    },
    "ZetaMallProduct": {
      "title": "ZetaMallProduct",
      "description": "Product listed in the ZetaMall online store catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 180 },
        "subtitle": { "type": "string", "maxLength": 240 },
        "category": { "type": "string", "maxLength": 80 },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "stock": { "type": "number" },
        "description": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "name", "category", "price"]
    },
    "ZetaMallOrder": {
      "title": "ZetaMallOrder",
      "description": "Customer order placed in ZetaMall.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 40 },
        "customerEmail": { "type": "string", "maxLength": 160 },
        "shippingAddress": { "type": "string", "maxLength": 300 },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pendiente", "pagado", "enviado", "entregado", "cancelado"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "customerName", "customerPhone", "total", "status", "createdAt"]
    },
    "ZetaMallCustomer": {
      "title": "ZetaMallCustomer",
      "description": "Registered customer profile in ZetaMall.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 40 },
        "address": { "type": "string", "maxLength": 300 },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/zetatrade_users/{userId}": {
      "schema": { "$ref": "#/entities/ZetaTradeUser" },
      "description": "ZetaTrade registered trader accounts synced across devices."
    },
    "/zetamall_products/{productId}": {
      "schema": { "$ref": "#/entities/ZetaMallProduct" },
      "description": "ZetaMall public catalog products managed by admin."
    },
    "/zetamall_orders/{orderId}": {
      "schema": { "$ref": "#/entities/ZetaMallOrder" },
      "description": "ZetaMall customer orders."
    },
    "/zetamall_customers/{customerId}": {
      "schema": { "$ref": "#/entities/ZetaMallCustomer" },
      "description": "ZetaMall registered customers."
    }
  }
}
