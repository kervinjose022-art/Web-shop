rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- DEFAULT DENY ALL ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- SECURITY HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'kervinjose022@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidZetaTradeUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'realBalance', 'demoBalance', 'role', 'status', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.realBalance is number && data.realBalance >= 0
        && data.demoBalance is number && data.demoBalance >= 0
        && data.role in ['user', 'vip', 'admin']
        && data.status in ['active', 'suspended']
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidZetaMallProduct(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'price'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 180
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.price is number && data.price >= 0;
    }

    function isValidZetaMallOrder(data) {
      return data.keys().hasAll(['id', 'userId', 'customerName', 'customerPhone', 'total', 'status', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && data.customerPhone is string && data.customerPhone.size() >= 1 && data.customerPhone.size() <= 40
        && data.total is number && data.total >= 0
        && data.status in ['pendiente', 'pagado', 'enviado', 'entregado', 'cancelado']
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidZetaMallCustomer(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.role in ['customer', 'admin']
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // --- ZETATRADE USERS ---
    match /zetatrade_users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isValidZetaTradeUser(request.resource.data)
        && ((isOwner(userId) && request.resource.data.role == 'user' && request.resource.data.status == 'active') || isAdmin());
      allow update: if isValidId(userId)
        && isValidZetaTradeUser(request.resource.data)
        && (isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role && request.resource.data.status == resource.data.status));
      allow delete: if isValidId(userId) && isAdmin();
    }

    // --- ZETAMALL PRODUCTS (Public Catalog Read, Admin Write) ---
    match /zetamall_products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create, update: if isValidId(productId) && isAdmin() && isValidZetaMallProduct(request.resource.data);
      allow delete: if isValidId(productId) && isAdmin();
    }

    // --- ZETAMALL ORDERS ---
    match /zetamall_orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId)
        && isSignedIn()
        && isValidZetaMallOrder(request.resource.data)
        && request.resource.data.userId == request.auth.uid;
      allow update: if isValidId(orderId) && isAdmin() && isValidZetaMallOrder(request.resource.data);
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // --- ZETAMALL CUSTOMERS ---
    match /zetamall_customers/{customerId} {
      allow get: if isValidId(customerId) && (isOwner(customerId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(customerId)
        && isValidZetaMallCustomer(request.resource.data)
        && ((isOwner(customerId) && request.resource.data.role == 'customer') || isAdmin());
      allow update: if isValidId(customerId)
        && isValidZetaMallCustomer(request.resource.data)
        && (isAdmin() || (isOwner(customerId) && request.resource.data.role == resource.data.role));
      allow delete: if isValidId(customerId) && isAdmin();
    }
  }
}
